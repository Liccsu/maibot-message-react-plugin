{
  "manifest_version": 2,
  "id": "liccsu.maibot-message-react-plugin",
  "version": "2.1.2",
  "name": "maibot-message-react-plugin - 麦麦贴表情",
  "description": "通过 Napcat API 赋予麦麦对消息贴表情的能力，LLM 自动选择合适的表情对群聊消息做出反应",
  "author": {
    "name": "Liccsu",
    "url": "https://github.com/Liccsu"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Liccsu/maibot-message-react-plugin",
    "homepage": "https://github.com/Liccsu/maibot-message-react-plugin",
    "issues": "https://github.com/Liccsu/maibot-message-react-plugin/issues"
  },
  "host_application": {
    "min_version": "1.2.5",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.1",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "emoji",
      "value": "💖",
      "background": "#7a617f"
    }
  },
  "capabilities": ["llm.generate", "llm.get_available_models", "message.get_recent"],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
